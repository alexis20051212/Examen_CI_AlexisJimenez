<mxfile><diagram name="Flujo CI"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Flujo de Integración Continua&lt;/b&gt;&lt;br&gt;Alexis Jiménez Salas" style="text;html=1;align=center;fontSize=16;" vertex="1" parent="1"><mxGeometry x="260" y="10" width="320" height="50" as="geometry"/></mxCell><mxCell id="a" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="80" width="120" height="45" as="geometry"/></mxCell><mxCell id="b" value="1. Modificación del código" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="240" height="55" as="geometry"/></mxCell><mxCell id="c" value="2. Commit&lt;br&gt;(git commit -m &amp;quot;...&amp;quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="240" height="55" as="geometry"/></mxCell><mxCell id="d" value="3. Envío al repositorio&lt;br&gt;(git push)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="340" width="240" height="55" as="geometry"/></mxCell><mxCell id="e" value="4. Ejecución automática de CI&lt;br&gt;(GitHub Actions / Jenkins)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="430" width="240" height="55" as="geometry"/></mxCell><mxCell id="f" value="5. Ejecución de pruebas automatizadas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="240" height="55" as="geometry"/></mxCell><mxCell id="g" value="6. ¿Las pruebas pasan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="610" width="160" height="110" as="geometry"/><